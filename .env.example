# Required Docker Compose deployment values. Do not commit a populated .env file.
COMPOSE_PROJECT_NAME=analytics-dashboard
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=analytics
MYSQL_USER=analytics
MYSQL_PASSWORD=
NODE_ENV=production
JWT_SECRET=
PASSWORD_PEPPER=
CLIENT_ORIGIN=https://app.example.com
CORS_ORIGINS=https://app.example.com
TRUSTED_HOSTS=app.example.com
TRUST_PROXY_HEADERS=true
# Exact Nginx peer as seen by Uvicorn. Required if proxy-header trust is enabled.
TRUSTED_PROXY_CIDRS=
# Exact TLS-edge peer as seen by Nginx; loopback only is a safe local default.
TRUSTED_EDGE_CIDR=127.0.0.1/32
FORCE_HTTPS=true
RATE_LIMIT_STORAGE_URL=redis://redis:6379/1
METRICS_TOKEN=
ANALYTICS_MAX_RESPONSE_BYTES=5242880
JOB_MAX_RESULT_BYTES=20971520
INTERACTIVE_EXPORT_MAX_BYTES=10485760
JOB_MAX_ARTIFACT_BYTES=262144000
AI_LAYOUT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_TIMEOUT_SECONDS=25
VITE_API_BASE_URL=/api
FRONTEND_PORT=8080
