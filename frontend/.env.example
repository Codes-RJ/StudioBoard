VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME="Analytics Dashboard"
VITE_APP_VERSION=1.0.0
# Personal workspace default. Set true only for an explicitly separate legacy server build.
VITE_ENABLE_SERVER_WORKSPACE=false
# Keep false for release. The pinned small LLM has not passed numerical quality evaluation.
VITE_ENABLE_EXPERIMENTAL_LOCAL_LLM=false
# Set only for the intended public production origin. Empty previews are noindex.
VITE_PUBLIC_SITE_URL=
