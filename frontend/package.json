{
  "name": "analytics-dashboard-frontend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/prerender.jsx --outDir .prerender && node scripts/prerender.mjs && node scripts/third-party-notices.mjs",
    "build:evaluation": "node scripts/build-model-evaluation.mjs --experimental",
    "build:release": "node scripts/build-model-evaluation.mjs --release",
    "build:netlify": "node scripts/build-netlify.mjs",
    "check": "npm run check:contracts && npm run build && npm run check:bundle && npm run test:run",
    "lint:contracts": "eslint src/utils/exactDecimal.js src/utils/finiteArithmetic.js src/utils/datasetWorkerPayload.js src/utils/datasetWorkerReader.js src/utils/qualityReview.js src/utils/analysisScope.js src/utils/localDatasetStore.js src/utils/delimitedParser.worker.js src/utils/localDatasetDatabase.js src/utils/localImportStorage.js src/utils/chartPanelData.js src/hooks/useDatasetSelection.js src/hooks/useLayoutEditing.js src/hooks/useDashboardSummary.js src/hooks/useChartSeries.js --max-warnings 0",
    "check:types": "tsc -p tsconfig.contracts.json",
    "check:contracts": "npm run lint:contracts && npm run check:types",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:notices": "node scripts/third-party-notices.mjs --strict",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "benchmark:assistant": "node scripts/benchmark-ai-query.mjs",
    "benchmark:relationships": "node scripts/benchmark-relationships.mjs",
    "benchmark:incremental": "node scripts/benchmark-incremental-analysis.mjs",
    "benchmark:browser": "node scripts/benchmark-browser-collections.mjs",
    "benchmark:imports": "node scripts/benchmark-import-journey.mjs",
    "benchmark:collection": "node scripts/benchmark-collection-journey.mjs",
    "benchmark:capacity": "node scripts/run-capacity-benchmarks.mjs",
    "evaluate:models": "node scripts/evaluate-local-models.mjs",
    "check:deployment": "node scripts/deployment-preflight.mjs",
    "check:host-traffic": "node scripts/check-host-traffic.mjs",
    "build:social-preview": "node scripts/capture-social-preview.mjs",
    "optimize:images": "npm run build:social-preview"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@mlc-ai/web-llm": "0.2.85",
    "@tanstack/react-virtual": "^3.0.0-beta.68",
    "axios": "1.20.0",
    "clsx": "^2.0.0",
    "fflate": "0.8.3",
    "framer-motion": "14.1.0",
    "onnxruntime-web": "1.31.0-dev.20260918-bc8e7ed75",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "6.3.289",
    "plotly.js-cartesian-dist-min": "^4.1.0",
    "plotly.js-dist-min": "^4.1.0",
    "plotly.js-finance-dist-min": "^4.1.0",
    "plotly.js-gl3d-dist-min": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-grid-layout": "^1.4.4",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.11.0",
    "react-resizable": "^3.0.5",
    "react-router-dom": "7.18.3",
    "react-table": "^7.8.0",
    "recharts": "^2.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "autoprefixer": "^10.4.16",
    "eslint": "9.39.2",
    "fake-indexeddb": "6.2.4",
    "jsdom": "^23.0.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
