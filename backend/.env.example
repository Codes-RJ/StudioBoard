# Database
DATABASE_URL="mysql://user:password@localhost:3306/analytics"

# JWT
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
PASSWORD_PEPPER="replace-with-a-long-random-password-pepper"

# Analytics Engine
ANALYTICS_ENGINE_URL="http://localhost:8000"

# Client
CLIENT_ORIGIN="http://localhost:5173"

# Server
PORT=5000
NODE_ENV="development"
# Leave disabled for personal browser workspaces.
ALLOW_SERVER_WORKSPACE=false

# File Upload
UPLOAD_MAX_SIZE=104857600
STORAGE_ORPHAN_GRACE_SECONDS=86400
LIVE_SNAPSHOT_CACHE_MAX_ENTRIES=32
LIVE_SNAPSHOT_CACHE_MAX_BYTES=16777216
UPLOAD_PATH="./uploads"
USER_STORAGE_QUOTA_MB=250
USER_DATASET_LIMIT=25

# CORS
CORS_ORIGINS="http://localhost:5173"

# Cookies
COOKIE_SAME_SITE="lax"
COOKIE_SECURE=false
# COOKIE_DOMAIN=""
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
FORCE_HTTPS=false
RATE_LIMIT_STORAGE_URL=memory://

# Analytics Query Endpoint
CUSTOM_QUERY_ENABLED=false
AI_LAYOUT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_TIMEOUT_SECONDS=25
